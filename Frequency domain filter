def distance_grid(shape):
  rows, cols = shape
  u = np.arange(rows) - rows / 2.0
  v = np.arange(cols) - cols / 2.0
  V, U = np.meshgrid(v, u)
  return np.sqrt(U**2 + V**2)


def apply_freq_filter(image, H):
  f_shift = np.fft.fftshift(np.fft.fft2(image.astype(np.float32)))
  filtered_shift = f_shift * H
  img_back = np.fft.ifft2(np.fft.ifftshift(filtered_shift))
  return np.clip(np.abs(img_back), 0, 255).astype(np.uint8)


D = distance_grid(img.shape)
D0 = 30.0  # Cutoff frequency
n = 2  # Butterworth order

# Low-Pass Transfer Functions
H_ilpf = (D <= D0).astype(np.float32)
H_blpf = 1.0 / (1.0 + (D / D0) ** (2 * n))
H_glpf = np.exp(-(D**2) / (2 * (D0**2)))

# High-Pass Transfer Functions
H_ihpf = 1.0 - H_ilpf
H_bhpf = 1.0 - H_blpf
H_ghpf = 1.0 - H_glpf

# Apply Low-Pass Filters
ilpf_img = apply_freq_filter(img, H_ilpf)
blpf_img = apply_freq_filter(img, H_blpf)
glpf_img = apply_freq_filter(img, H_glpf)

# Apply High-Pass Versions
ihpf_img = apply_freq_filter(img, H_ihpf)
bhpf_img = apply_freq_filter(img, H_bhpf)
ghpf_img = apply_freq_filter(img, H_ghpf)

fig, axes = plt.subplots(2, 3, figsize=(14, 9))
lp_results = [
    (f"Ideal LPF (D0={D0})", ilpf_img),
    (f"Butterworth LPF (D0={D0}, n={n})", blpf_img),
    (f"Gaussian LPF (D0={D0})", glpf_img),
]
hp_results = [
    (f"Ideal HPF (D0={D0})", ihpf_img),
    (f"Butterworth HPF (D0={D0}, n={n})", bhpf_img),
    (f"Gaussian HPF (D0={D0})", ghpf_img),
]

for ax, (title, im) in zip(axes[0], lp_results):
  ax.imshow(im, cmap="gray", vmin=0, vmax=255)
  ax.set_title(title)
  ax.axis("off")

for ax, (title, im) in zip(axes[1], hp_results):
  ax.imshow(im, cmap="gray", vmin=0, vmax=255)
  ax.set_title(title)
  ax.axis("off")

plt.tight_layout()
plt.show()
